# Modèle de configuration du serveur BIM NEXT.
# Copier ce fichier en `.env` sur le serveur, puis remplir les valeurs.
# Ne jamais commiter le vrai `.env` (il contient des secrets).

# ── Serveur ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Adresse publique du serveur (sans / final). Sert à construire le lien de
# l'e-mail « Mot de passe oublié » : https://…/api/v1/auth/reset-link/<jeton>
PUBLIC_API_URL=https://serverbimnext.masmara-dimajelo.org

# ── Base de données (MySQL) ──────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Jetons de session ────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── E-mails ──────────────────────────────────────────────────────────────
EMAIL_PASSWORD=
SUPPORT_EMAIL=

# ── Paiements ────────────────────────────────────────────────────────────
FLEXPAY_BASE_URL=
FLEXPAY_CHECK_URL=
FLEXPAY_CARD_URL=
FLEXPAY_CALLBACK_URL=
FLEXPAY_MERCHANT=
FLEXPAY_TOKEN=
MAXICASH_MERCHANT_ID=
MAXICASH_MERCHANT_PASSWORD=

# ── Cartes (taxi) ────────────────────────────────────────────────────────
GOOGLE_MAPS_JS_API_KEY=
